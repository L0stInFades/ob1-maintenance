{
  "name": "ob1-local-maintenance",
  "version": "0.1.725-recovered.0",
  "private": true,
  "description": "Local recovery and maintenance workspace for the installed OB1 binary",
  "scripts": {
    "extract": "python3 scripts/extract_sea.py",
    "format": "node scripts/format.cjs",
    "analyze": "node scripts/analyze.cjs",
    "build": "node scripts/build.cjs",
    "test": "python3 -m unittest discover -s tests -v && node --test tests/test_ast_audit.cjs",
    "test:ast": "node --test tests/test_ast_audit.cjs",
    "smoke": "python3 scripts/smoke.py --include-build",
    "test:offline": "python3 scripts/offline-test.py",
    "verify:source": "node --expose-gc scripts/verify-source.cjs",
    "verify:build": "python3 scripts/verify-build.py",
    "audit:runtime": "python3 scripts/audit-runtime.py",
    "audit:static": "python3 scripts/audit-static.py",
    "audit:behavior": "python3 scripts/audit_behavior.py",
    "audit:search": "python3 scripts/audit_behavior.py --case glob-and-grep --report search-audit.json",
    "audit:http": "python3 scripts/audit_http.py",
    "audit:rebuild": "python3 scripts/audit_rebuild.py",
    "audit:summary": "python3 scripts/audit-summary.py",
    "lookup": "node scripts/lookup.cjs",
    "dev": "node scripts/dev.cjs",
    "start": "node scripts/dev.cjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "prettier": "3.6.2"
  }
}
